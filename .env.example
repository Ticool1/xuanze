# ===== 服务配置 =====
# 监听端口
PORT=3000
# 监听地址（0.0.0.0 允许公网访问）
HOST=0.0.0.0

# ===== 后台管理 =====
# 后台登录密码（务必修改！）
ADMIN_PASSWORD=admin123
# 会话签名密钥（务必改成随机长字符串）
SESSION_SECRET=change-me-to-a-long-random-string

# ===== 对外访问地址 =====
# 二维码将指向这个地址，必须是手机能访问的（公网 IP 或域名）
# 例：http://154.8.201.41  或  https://shop.example.com
PUBLIC_BASE_URL=http://154.8.201.41

# ===== 店铺信息 =====
SHOP_NAME=选择蛋糕店
SHOP_PHONE=13504418782

# ===== 腾讯云 COS 对象存储（可选）=====
# 配置后，商品图片会存到 COS，节省服务器带宽、加速访问
# 使用前先在 COS 控制台创建存储桶，并设置好访问权限
COS_ENABLED=false
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=your-bucket-1250000000
COS_REGION=ap-beijing
# 自定义域名（可选），不填则用默认 COS 域名
COS_DOMAIN=
