[Unit]
Description=选择蛋糕店 扫码选购系统
Documentation=https://github.com/Ticool1/xuanze
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/xuanze
ExecStart=/usr/bin/node server/app.js
Restart=always
RestartSec=3
StandardOutput=append:/var/log/xuanze/app.log
StandardError=append:/var/log/xuanze/error.log

# 环境变量从 /opt/xuanze/.env 读取（由 server/app.js 自行加载）
Environment=NODE_ENV=production

# 说明：不要开启 ProtectSystem=full / PrivateTmp 等加固选项，
# 它们会让 node 在部分机器上以 status=226/NAMESPACE 启动失败。
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
